# Datadog API Configuration
# Copy this file to .env and fill in your actual values

# Required: Your Datadog API key
DD_API_KEY=your-api-key-here

# Required: Your Datadog Application key
DD_APP_KEY=your-app-key-here

# Optional: Datadog site (default: datadoghq.com)
# Other options: datadoghq.eu, us3.datadoghq.com, us5.datadoghq.com, etc.
DD_SITE=datadoghq.com

# Optional: Name/description for the API key
DD_API_KEY_NAME=My API Key

# Optional: Name/description for the Application key
DD_APP_KEY_NAME=My App Key

# Optional: Application key identifier (for metadata lookup)
DD_KEY_ID=optional-key-id